{
  "name": "hereby-tools",
  "version": "1.0.0",
  "type": "module",
  "description": "Small collection of highly opinionated tools to work with Hereby task runner",
  "main": "lib/index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "rimraf lib && tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "release": "commit-and-tag-version"
  },
  "files": [
    "lib/**/*"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "keywords": [
    "hereby",
    "task-runner"
  ],
  "homepage": "https://github.com/gergof/hereby-tools#readme",
  "bugs": {
    "url": "https://github.com/gergof/hereby-tools/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gergof/hereby-tools.git"
  },
  "license": "MIT",
  "author": "Fandly Gergo <fandly.gergo@fndl.ro>",
  "peerDependencies": {
    "hereby": "^1.15.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "commit-and-tag-version": "^13.2.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "hereby": "^1.15.2",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "execa": "^10.0.1"
  }
}
